{
  "name": "dsh-emotion-memory",
  "version": "0.1.0",
  "description": "情绪记忆模型 0.1：PAD 情绪场 + 带情感指纹的记忆，一套注入",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./package.json": "./package.json",
    "./client": "./client.js"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-settings-plugins"
      ]
    }
  },
  "peerDependencies": {
    "@deepseek-ai/dsh": "*"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "emotion",
    "pad",
    "memory",
    "affective-computing"
  ],
  "license": "MIT",
  "files": [
    "lib",
    "client.js",
    "cordis.patch.yml",
    "README.md",
    "CHANGELOG.md"
  ],
  "engines": {
    "dsh": ">=0.2.1-rc.2"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/xsy822/dsh-emotion-memory.git"
  },
  "homepage": "https://github.com/xsy822/dsh-emotion-memory#readme",
  "author": "xiaoshiyan"
}
